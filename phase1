plt.tight_layout()
plt.savefig('phase1_confusion_matrices.png', dpi=300, bbox_inches='tight')
plt.show()

# 5. Save Model Results
print("\n" + "="*50)
print("SAVING RESULTS")
print("="*50)

results_df = pd.DataFrame({
    'Model': ['Random Forest', 'SVM'],
    'Accuracy': [accuracy_score(y_test, rf_pred), accuracy_score(y_test, svm_pred)],
    'Precision': [precision_score(y_test, rf_pred), precision_score(y_test, svm_pred)],
    'Recall': [recall_score(y_test, rf_pred), recall_score(y_test, svm_pred)],
    'F1_Score': [f1_score(y_test, rf_pred), f1_score(y_test, svm_pred)],
    'ROC_AUC': [roc_auc_score(y_test, rf_pred_proba), roc_auc_score(y_test, svm_pred_proba)]
